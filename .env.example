# --- Model providers (set at least one tier-small key) ---
# LiteLLM picks up these standard env vars automatically.

# Free / cheap tiers good for tier-small (summarization, extraction, dedup)
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# tier-reasoning candidates
DEEPSEEK_API_KEY=

# tier-quality (final synthesis only — keep usage low)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Web search (optional; falls back to DuckDuckGo if unset) ---
TAVILY_API_KEY=

# --- EDGAR (optional) ---
# SEC requires a User-Agent identifying the requester.
EDGAR_USER_AGENT="Your Name your.email@example.com"

# --- Budget guardrails ---
THESIS_MAX_COST_USD=0.40
THESIS_CACHE_DIR=.diskcache

# --- Prompt versioning (used in cache keys) ---
THESIS_PROMPT_VERSION=v1
